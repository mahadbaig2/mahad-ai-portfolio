{
  "openapi": "3.1.0",
  "info": {
    "title": "Mahad AI Portfolio API",
    "description": "FastAPI backend and LangGraph orchestrator for Mahad's AI Product Engineering Portfolio assistant.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Liveness Probe",
        "description": "Returns HTTP 200 as long as the API process is running and responding.",
        "operationId": "get_liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Readiness Probe",
        "description": "Returns HTTP 200 when backing dependencies (database, storage) are available.",
        "operationId": "get_readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/version": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Version Metadata",
        "description": "Returns application version and runtime environment information.",
        "operationId": "get_version_health_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhooks/sanity": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Handle Sanity Webhook",
        "description": "Receive and process Sanity published/updated/deleted webhooks.",
        "operationId": "handle_sanity_webhook_api_v1_webhooks_sanity_post",
        "parameters": [
          {
            "name": "sanity-webhook-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sanity-Webhook-Signature"
            }
          },
          {
            "name": "sanity-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sanity-Signature"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Handle Sanity Webhook Api V1 Webhooks Sanity Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/router/classify": {
      "post": {
        "tags": [
          "Query Router"
        ],
        "summary": "Classify user query using in-process ONNX model",
        "description": "Returns predicted route, intent, answerability, language, confidence, and fallback status.",
        "operationId": "classify_query_api_v1_router_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouterPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/session": {
      "post": {
        "tags": [
          "Assistant"
        ],
        "summary": "Create a bounded conversation session",
        "description": "Initializes a new session with affirmative consent tracking, persona selection, and TTL (P9.4.1).",
        "operationId": "create_session_api_v1_assistant_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/session/{session_id}": {
      "get": {
        "tags": [
          "Assistant"
        ],
        "summary": "Retrieve session metadata and message history",
        "description": "Returns session configuration and consented message turns bounded to the last 50 entries (P9.4.1).",
        "operationId": "get_session_detail_api_v1_assistant_session__session_id__get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/chat": {
      "post": {
        "tags": [
          "Assistant"
        ],
        "summary": "Execute single grounded assistant conversation turn",
        "description": "Synchronous turn endpoint orchestrating LangGraph routing, RAG retrieval, recovery, and citations (P9.4.1).",
        "operationId": "chat_endpoint_api_v1_assistant_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantChatResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/chat/stream": {
      "post": {
        "tags": [
          "Assistant"
        ],
        "summary": "Stream grounded assistant response with SSE progress events and tokens",
        "description": "Server-Sent Events endpoint streaming execution progress steps, token deltas, and completion payload (P9.4.2).",
        "operationId": "chat_stream_endpoint_api_v1_assistant_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/transcription/transcribe": {
      "post": {
        "tags": [
          "Transcription"
        ],
        "summary": "Transcribe voice audio to text via Groq Whisper",
        "description": "Transcribe a bounded audio upload using Groq Whisper.\n\nThe file bytes are held in memory only for the duration of the API call.\nRaw audio is never persisted to storage (P12.2.5).",
        "operationId": "transcribe_audio_api_v1_transcription_transcribe_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_transcribe_audio_api_v1_transcription_transcribe_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerabilityLabel": {
        "type": "string",
        "enum": [
          "answerable",
          "unanswerable"
        ],
        "title": "AnswerabilityLabel",
        "description": "Whether query is answerable from portfolio grounding data."
      },
      "AssistantChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "description": "User question or prompt"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id",
            "description": "Session ID for tracking and consent"
          },
          "persona": {
            "type": "string",
            "title": "Persona",
            "description": "Audience style: general, recruiter, engineer, founder",
            "default": "general"
          },
          "mode": {
            "$ref": "#/components/schemas/AssistantMode",
            "description": "Text chat or push-to-talk voice",
            "default": "text"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/ChatMessagePayload"
            },
            "type": "array",
            "title": "History",
            "description": "Prior conversation transcript (max 20 turns)"
          },
          "consent_given": {
            "type": "boolean",
            "title": "Consent Given",
            "description": "User consent to store telemetry and message logs",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "AssistantChatRequest",
        "description": "Public incoming request to the assistant endpoint."
      },
      "AssistantChatResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Citations",
            "description": "Referenced chunk IDs"
          },
          "route": {
            "$ref": "#/components/schemas/RouteLabel"
          },
          "language": {
            "$ref": "#/components/schemas/LanguageLabel"
          },
          "is_safe": {
            "type": "boolean",
            "title": "Is Safe",
            "default": true
          },
          "mode": {
            "$ref": "#/components/schemas/AssistantMode"
          },
          "suggested_actions": {
            "items": {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            "type": "array",
            "title": "Suggested Actions",
            "description": "Structured links or UI actions"
          },
          "navigation_target": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Navigation Target",
            "description": "Direct page navigation recommendation"
          },
          "execution_steps": {
            "items": {
              "$ref": "#/components/schemas/ExecutionStepPayload"
            },
            "type": "array",
            "title": "Execution Steps"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "answer",
          "route",
          "language",
          "mode"
        ],
        "title": "AssistantChatResponse",
        "description": "Completed grounded response returned by the assistant graph."
      },
      "AssistantMode": {
        "type": "string",
        "enum": [
          "text",
          "voice"
        ],
        "title": "AssistantMode",
        "description": "Interaction mode for assistant."
      },
      "Body_transcribe_audio_api_v1_transcription_transcribe_post": {
        "properties": {
          "audio": {
            "type": "string",
            "format": "binary",
            "title": "Audio",
            "description": "Audio file to transcribe"
          }
        },
        "type": "object",
        "required": [
          "audio"
        ],
        "title": "Body_transcribe_audio_api_v1_transcription_transcribe_post"
      },
      "ChatMessagePayload": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/ChatMessageRole"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          },
          "timestamp": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessagePayload",
        "description": "A single turn in the conversation transcript."
      },
      "ChatMessageRole": {
        "type": "string",
        "enum": [
          "user",
          "assistant",
          "system"
        ],
        "title": "ChatMessageRole"
      },
      "CreateSessionRequest": {
        "properties": {
          "consent_given": {
            "type": "boolean",
            "title": "Consent Given",
            "description": "Affirmative user consent to store logs",
            "default": false
          },
          "persona": {
            "type": "string",
            "title": "Persona",
            "description": "Target audience style persona",
            "default": "general"
          }
        },
        "type": "object",
        "title": "CreateSessionRequest",
        "description": "Payload to create a new bounded conversation session."
      },
      "CreateSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "consent_given": {
            "type": "boolean",
            "title": "Consent Given"
          },
          "persona": {
            "type": "string",
            "title": "Persona"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "consent_given",
          "persona",
          "expires_at"
        ],
        "title": "CreateSessionResponse",
        "description": "Created session metadata."
      },
      "DependencyCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error",
              "skipped"
            ],
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms",
            "description": "Latency of check in ms"
          },
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DependencyCheck"
      },
      "ExecutionStepPayload": {
        "properties": {
          "step_name": {
            "type": "string",
            "title": "Step Name"
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "completed"
          },
          "details": {
            "type": "object",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "step_name",
          "duration_ms"
        ],
        "title": "ExecutionStepPayload",
        "description": "Telemetry record for execution inspector."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthLiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive",
              "degraded",
              "dead"
            ],
            "title": "Status",
            "description": "Liveness status of the API service process",
            "default": "alive",
            "examples": [
              "alive"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mahad-portfolio-api"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development",
              "production"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "UTC timestamp of the probe response"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "timestamp"
        ],
        "title": "HealthLiveResponse"
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "description": "Readiness status indicating if the service can handle live requests",
            "default": "ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mahad-portfolio-api"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "type": "object",
            "title": "Checks",
            "description": "Individual status of backing dependencies"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "timestamp"
        ],
        "title": "HealthReadyResponse"
      },
      "IntentLabel": {
        "type": "string",
        "enum": [
          "project_technical",
          "project_overview",
          "career_skills",
          "article_discussion",
          "contact_info",
          "greeting",
          "general_chitchat",
          "out_of_domain",
          "prompt_injection"
        ],
        "title": "IntentLabel",
        "description": "Semantic intent of incoming user query."
      },
      "LanguageLabel": {
        "type": "string",
        "enum": [
          "en",
          "ur"
        ],
        "title": "LanguageLabel",
        "description": "Detected language: en (English) or ur (Roman Urdu)."
      },
      "RouteLabel": {
        "type": "string",
        "enum": [
          "rag_retrieval",
          "direct_chat",
          "deterministic",
          "clarification",
          "refusal"
        ],
        "title": "RouteLabel",
        "description": "Execution route decided by query router or graph pipeline."
      },
      "RouterPredictionRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text",
            "description": "User query text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "RouterPredictionRequest",
        "description": "Input payload for query router classification."
      },
      "RouterPredictionResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "route": {
            "$ref": "#/components/schemas/RouteLabel"
          },
          "route_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Route Confidence"
          },
          "intent": {
            "$ref": "#/components/schemas/IntentLabel"
          },
          "intent_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Intent Confidence"
          },
          "answerability": {
            "$ref": "#/components/schemas/AnswerabilityLabel"
          },
          "language": {
            "$ref": "#/components/schemas/LanguageLabel"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback",
            "default": false
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "text",
          "route",
          "route_confidence",
          "intent",
          "intent_confidence",
          "answerability",
          "language",
          "model_name",
          "model_version",
          "latency_ms"
        ],
        "title": "RouterPredictionResponse",
        "description": "Prediction output from the in-process ONNX query router."
      },
      "SessionDetailResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Session Id"
          },
          "consent_given": {
            "type": "boolean",
            "title": "Consent Given"
          },
          "persona": {
            "type": "string",
            "title": "Persona"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessagePayload"
            },
            "type": "array",
            "title": "Messages"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "consent_given",
          "persona",
          "expires_at",
          "message_count"
        ],
        "title": "SessionDetailResponse",
        "description": "Session details and bounded message history."
      },
      "TranscriptionResponse": {
        "properties": {
          "transcript": {
            "type": "string",
            "title": "Transcript",
            "description": "Transcribed text from the audio input"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "description": "BCP-47 language code detected by Whisper"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Duration Seconds",
