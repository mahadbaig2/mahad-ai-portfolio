{
  "openapi": "3.1.0",
  "info": {
    "title": "Mahad AI Portfolio API",
    "description": "FastAPI backend and LangGraph orchestrator for Mahad's AI Product Engineering Portfolio assistant.",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Liveness Probe",
        "description": "Returns HTTP 200 as long as the API process is running and responding.",
        "operationId": "get_liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Readiness Probe",
        "description": "Returns HTTP 200 when backing dependencies (database, storage) are available.",
        "operationId": "get_readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/version": {
      "get": {
        "tags": [
          "Health & Diagnostics"
        ],
        "summary": "Version Metadata",
        "description": "Returns application version and runtime environment information.",
        "operationId": "get_version_health_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/webhooks/sanity": {
      "post": {
        "tags": [
          "Webhooks"
        ],
        "summary": "Handle Sanity Webhook",
        "description": "Receive and process Sanity published/updated/deleted webhooks.",
        "operationId": "handle_sanity_webhook_api_v1_webhooks_sanity_post",
        "parameters": [
          {
            "name": "sanity-webhook-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sanity-Webhook-Signature"
            }
          },
          {
            "name": "sanity-signature",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Sanity-Signature"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Handle Sanity Webhook Api V1 Webhooks Sanity Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/router/classify": {
      "post": {
        "tags": [
          "Query Router"
        ],
        "summary": "Classify user query using in-process ONNX model",
        "description": "Returns predicted route, intent, answerability, language, confidence, and fallback status.",
        "operationId": "classify_query_api_v1_router_classify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouterPredictionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouterPredictionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerabilityLabel": {
        "type": "string",
        "enum": [
          "answerable",
          "unanswerable"
        ],
        "title": "AnswerabilityLabel",
        "description": "Whether query is answerable from portfolio grounding data."
      },
      "DependencyCheck": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warning",
              "error",
              "skipped"
            ],
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "latency_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latency Ms",
            "description": "Latency of check in ms"
          },
          "details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DependencyCheck"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthLiveResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "alive",
              "degraded",
              "dead"
            ],
            "title": "Status",
            "description": "Liveness status of the API service process",
            "default": "alive",
            "examples": [
              "alive"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mahad-portfolio-api"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development",
              "production"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp",
            "description": "UTC timestamp of the probe response"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "timestamp"
        ],
        "title": "HealthLiveResponse"
      },
      "HealthReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "description": "Readiness status indicating if the service can handle live requests",
            "default": "ready",
            "examples": [
              "ready"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mahad-portfolio-api"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyCheck"
            },
            "type": "object",
            "title": "Checks",
            "description": "Individual status of backing dependencies"
          }
        },
        "type": "object",
        "required": [
          "environment",
          "timestamp"
        ],
        "title": "HealthReadyResponse"
      },
      "IntentLabel": {
        "type": "string",
        "enum": [
          "project_technical",
          "project_overview",
          "career_skills",
          "article_discussion",
          "contact_info",
          "greeting",
          "general_chitchat",
          "out_of_domain",
          "prompt_injection"
        ],
        "title": "IntentLabel",
        "description": "Semantic intent of incoming user query."
      },
      "LanguageLabel": {
        "type": "string",
        "enum": [
          "en",
          "ur"
        ],
        "title": "LanguageLabel",
        "description": "Detected language: en (English) or ur (Roman Urdu)."
      },
      "RouteLabel": {
        "type": "string",
        "enum": [
          "rag_retrieval",
          "direct_chat",
          "refusal"
        ],
        "title": "RouteLabel",
        "description": "Execution route decided by query router."
      },
      "RouterPredictionRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Text",
            "description": "User query text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "RouterPredictionRequest",
        "description": "Input payload for query router classification."
      },
      "RouterPredictionResponse": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "route": {
            "$ref": "#/components/schemas/RouteLabel"
          },
          "route_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Route Confidence"
          },
          "intent": {
            "$ref": "#/components/schemas/IntentLabel"
          },
          "intent_confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Intent Confidence"
          },
          "answerability": {
            "$ref": "#/components/schemas/AnswerabilityLabel"
          },
          "language": {
            "$ref": "#/components/schemas/LanguageLabel"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback",
            "default": false
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "text",
          "route",
          "route_confidence",
          "intent",
          "intent_confidence",
          "answerability",
          "language",
          "model_name",
          "model_version",
          "latency_ms"
        ],
        "title": "RouterPredictionResponse",
        "description": "Prediction output from the in-process ONNX query router."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionResponse": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mahad-portfolio-api"
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development",
              "production"
            ]
          },
          "python_version": {
            "type": "string",
            "title": "Python Version",
            "examples": [
              "3.12.10"
            ]
          },
          "docs_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Docs Url",
            "default": "/docs"
          }
        },
        "type": "object",
        "required": [
          "version",
          "environment",
          "python_version"
        ],
        "title": "VersionResponse"
      }
    }
  }
}
