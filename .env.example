# ==============================================================================
# Mahad AI Portfolio - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git or expose sensitive keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# App / Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000

# ------------------------------------------------------------------------------
# Frontend (Next.js - apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sanity Public Configuration for Frontend
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# ------------------------------------------------------------------------------
# Sanity CMS (apps/studio & ingestion)
# ------------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Read token for server-side preview / ingestion pipeline
SANITY_API_READ_TOKEN=
# Webhook secret to verify incoming content update hooks
SANITY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Neon PostgreSQL (Operational DB)
# ------------------------------------------------------------------------------
# Async connection string for FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>/<database>?sslmode=require
# Synchronous connection string for Alembic migrations
DATABASE_URL_SYNC=postgresql://<username>:<password>@<host>/<database>?sslmode=require

# ------------------------------------------------------------------------------
# Qdrant Vector Database
# ------------------------------------------------------------------------------
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=mahad_portfolio_chunks

# ------------------------------------------------------------------------------
# Groq Inference (LLM & Whisper STT)
# ------------------------------------------------------------------------------
GROQ_API_KEY=
# LLM model configured via environment variable (not hardcoded)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# Speech-to-text model configured via environment variable
GROQ_WHISPER_MODEL=whisper-large-v3

# ------------------------------------------------------------------------------
# Embeddings & Query Router ML
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
ROUTER_MODEL_PATH=models/router.onnx
ROUTER_TOKENIZER_PATH=models/tokenizer

# ------------------------------------------------------------------------------
# Observability (LangSmith & MLflow)
# ------------------------------------------------------------------------------
# Disabled by default locally to protect free tier
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mahad-ai-portfolio
MLFLOW_TRACKING_URI=./mlruns

# ------------------------------------------------------------------------------
# Voice Service (OpenVoice V2 Cloned Voice)
# ------------------------------------------------------------------------------
VOICE_SERVICE_URL=http://localhost:8001
VOICE_SERVICE_API_KEY=

# ------------------------------------------------------------------------------
# Hugging Face Spaces (Deployments)
# ------------------------------------------------------------------------------
HF_SPACE_API_NAME=mahad-ai-portfolio-api
HF_SPACE_VOICE_NAME=mahad-ai-portfolio-voice
HF_TOKEN=

# ------------------------------------------------------------------------------
# Internal Security & API Tokens
# ------------------------------------------------------------------------------
INTERNAL_API_SECRET=
